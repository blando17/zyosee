# MongoDB Atlas. A local mongod URI also works: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/quantum_lab?appName=Cluster0

JWT_SECRET_KEY=your_secure_jwt_secret_here

# 5000 is taken by macOS Control Centre (AirPlay Receiver), and browsers
# refuse port 6000 (Chrome's blocked-port list, ERR_UNSAFE_PORT), so
# the accounts API sits here.
PORT=5001

# Database the collections live in (visible under this name in Atlas).
DB_NAME=quantum_lab

# Origins the browser may call these APIs from, comma separated. Vite prefers
# 5173 but silently moves to 5174 or 5175 when that port is already taken, so
# all three are allowed by default.
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Who may author problems. A comma-separated list of email addresses; an account
# whose email is not here cannot reach any of the /admin routes, whatever the
# frontend shows it. Empty means nobody, and the Add Problem page will say so.
ADMIN_EMAILS=

# Where the compiler service lives. Problem authoring calls it to run the
# reference solution that produces expected outputs.
COMPILER_URL=http://localhost:8000

# Where test files are written. The compiler container mounts this same folder
# read-only. Leave unset to use ../compiler/testdata.
TESTDATA_DIR=

# DNS. Only needed when Node cannot perform SRV lookups, which happens on macOS
# when the only nameserver is an IPv6 link-local address like fe80::1%en0. The
# symptom is "querySrv ECONNREFUSED" at startup while the web works normally.
# Leave empty to use the system resolver.
DNS_SERVERS=
