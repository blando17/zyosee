# The compile-and-run service. Kept separate from the accounts API on 5001 so
# a runaway program cannot take your login endpoints down with it.
PORT=8000

# Must be byte-identical to the accounts API's JWT_SECRET_KEY, otherwise this
# service cannot verify the tokens that API issues and every run is rejected.
JWT_SECRET_KEY=your_secure_jwt_secret_here

# Origins the browser may call these APIs from, comma separated. Vite prefers
# 5173 but silently moves to 5174 or 5175 when that port is already taken, so
# all three are allowed by default.
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Limits applied to every submitted program.
COMPILE_TIMEOUT_MS=10000
RUN_TIMEOUT_MS=5000
MAX_OUTPUT_BYTES=65536

# A first run faster than WARM_UP_CEILING_MS is repeated and the quicker time
# kept, because macOS spends about 600ms validating a newly built binary the
# first time it runs. Set WARM_UP_RUNS=0 to report the first run as-is.
WARM_UP_RUNS=1
WARM_UP_CEILING_MS=1500

# AI complexity analyser. Get a key at https://aistudio.google.com/apikey and
# paste it here, then restart this service. Leave it blank and the analyser
# panel simply does not appear.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# AI usage limits. Shared by the complexity reading and the coding assistant,
# and enforced on the server: disabling a button in the browser stops an honest
# click and nothing else.
AI_REQUESTS_PER_HOUR=10
AI_REQUESTS_PER_DAY=30
AI_REQUEST_COOLDOWN_SECONDS=5
AI_CACHE_TTL_MINUTES=30

# Caps on what is sent to Gemini and what comes back.
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_OUTPUT_TOKENS_FULL=1600
AI_MAX_CODE_CHARS=8000
AI_MAX_STATEMENT_CHARS=1800
AI_MAX_IO_CHARS=500
AI_MAX_ERROR_CHARS=1200

# MongoDB. Same cluster and database as the accounts API; the compiler only
# reads from it. Copy these two from backend/.env.
MONGODB_URI=
DB_NAME=

# Where generated and curated test files live. The Docker container mounts this
# read-only; leave it unset to use compiler/testdata.
TESTDATA_DIR=

# DNS. Only needed when Node cannot perform SRV lookups, which happens on macOS
# when the only nameserver is an IPv6 link-local address like fe80::1%en0. The
# symptom is "querySrv ECONNREFUSED" at startup while the web works normally.
# Leave empty to use the system resolver.
DNS_SERVERS=

# Redis holds the AI rate limits and the cache of answers already paid for.
# Without it those counters live in this process and reset on every restart,
# which is several times an afternoon while judge code is changing.
# docker compose overrides this with redis://redis:6379 inside its own network.
# Set REDIS_ENABLED=0 to switch Redis off and go back to in-memory counters.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=1
