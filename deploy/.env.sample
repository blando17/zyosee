# Copy to deploy/.env on the server and fill in. Never commit the filled copy.
#
# ONE FILE FOR EVERY SERVICE, which is why some values look unused: the backend
# ignores the Gemini key, the compiler ignores ADMIN_EMAILS, and each reads only
# what it needs. One file is fewer things to get out of step.

# --- the public address of the instance -------------------------------------
# Used by compose to bake the API URLs into the frontend bundle AND as the
# origin the APIs will accept requests from. Use the ELASTIC IP, not the
# instance's boot-time public IP, which changes on every stop/start and would
# silently break the frontend.
#   e.g. http://13.234.56.78
PUBLIC_URL=http://CHANGE-ME

# --- database ---------------------------------------------------------------
# A free Atlas M0 works. Use a DIFFERENT database name from your laptop's, so
# experimenting locally cannot touch what is deployed.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=zyosee_prod

# --- auth -------------------------------------------------------------------
# MUST be byte-identical across the services: the accounts API signs tokens
# with it and the compiler verifies them. If they drift, every submission is
# rejected as unauthenticated and the cause is not obvious.
# Generate one with:  openssl rand -base64 48
JWT_SECRET_KEY=CHANGE-ME

# Who may author problems. Comma separated; empty means nobody.
ADMIN_EMAILS=

# --- origins ----------------------------------------------------------------
# Behind the nginx proxy the browser only ever talks to one origin, so this is
# the public URL and nothing else.
CLIENT_URL=http://CHANGE-ME

# --- limits applied to submitted programs -----------------------------------
COMPILE_TIMEOUT_MS=10000
RUN_TIMEOUT_MS=5000
MAX_OUTPUT_BYTES=65536
WARM_UP_RUNS=1
WARM_UP_CEILING_MS=1500

# --- AI, optional -----------------------------------------------------------
# Leave blank and the analyser and assistant simply do not appear.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
AI_REQUESTS_PER_HOUR=10
AI_REQUESTS_PER_DAY=30

# --- queue ------------------------------------------------------------------
# Overridden by compose to redis://redis:6379 inside the network; left here so
# the file is complete.
REDIS_URL=redis://redis:6379
REDIS_ENABLED=1
