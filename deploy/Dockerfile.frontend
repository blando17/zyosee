# The React app, built then served by nginx.
#
# TWO STAGES, AND THE SECOND ONE IS THE POINT
#
# Stage one needs Node, npm and 400 MB of node_modules to produce a few hundred
# kilobytes of static files. Shipping that to production would mean running a
# Node process to serve files that never change, on a box with 1 GB of RAM.
#
# Stage two copies only the built assets into nginx:alpine, about 50 MB. The
# toolchain stays behind in a layer that is never shipped.
FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

# Baked in at BUILD time, not read at runtime: Vite substitutes these into the
# bundle, so the server's address is fixed when the image is built. That is why
# the deployment needs a stable address — an Elastic IP — rather than whatever
# public IP the instance happens to get after a restart.
#
# The websocket URL is derived from VITE_AUTH_URL by swapping http for ws, so
# it has to be an absolute URL. A relative path would produce an invalid
# socket address and Pair Lab and the Duel Arena would simply never connect.
ARG VITE_AUTH_URL
ARG VITE_COMPILER_URL
ENV VITE_AUTH_URL=$VITE_AUTH_URL
ENV VITE_COMPILER_URL=$VITE_COMPILER_URL

RUN npm run build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
