# The accounts API.
#
# No toolchains here, unlike the compiler image: this service never runs
# anybody's code. It is Node, Express and the Mongo driver, so the slim base is
# the right one and the image lands around 200 MB rather than 1.3 GB.
FROM node:22-bookworm-slim

WORKDIR /app

# package files first, so a code change does not re-run npm install. On a
# 1 GB t3.micro that is the difference between a 20-second rebuild and a
# three-minute one.
COPY backend/package*.json ./
RUN npm ci --omit=dev

COPY backend/ ./

# Same rule as the compiler image: nothing here runs as root.
USER node

EXPOSE 5001
CMD ["node", "index.js"]
